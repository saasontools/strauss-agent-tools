{
  "strauss-kb-context": {
    "PreInvocation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/context-inject.mjs",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "view_file|grep_search|find_by_name|list_dir",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/block-kb-reads.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
