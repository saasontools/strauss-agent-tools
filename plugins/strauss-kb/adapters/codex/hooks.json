{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "strauss-kb context --full-under 1500 2>/dev/null || true",
            "statusMessage": "Loading pinned knowledge bases"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "strauss-kb context --budget 2500 2>/dev/null || true",
            "statusMessage": "Refreshing pinned knowledge bases"
          }
        ]
      }
    ]
  }
}
