{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "plugin-strauss-kb-review",
  "projectType": "library",
  "implicitDependencies": ["companion-repo-fixture", "@saasontools/strauss-kb"],
  "targets": {
    "lint": {
      "command": "eslint .",
      "options": {
        "cwd": "plugins/strauss-kb-review"
      }
    },
    "typecheck": {
      "command": "tsc -p tsconfig.json",
      "options": {
        "cwd": "plugins/strauss-kb-review"
      }
    },
    "test": {
      // The fixture's records are markdown the integration test reads, so the
      // dependency side opts back out of `noMarkdown`. See AGENTS.md.
      "inputs": [
        "noMarkdown",
        "^default",
        "{workspaceRoot}/fixtures/companion-repo/**/*"
      ],
      "dependsOn": [
        { "projects": ["@saasontools/strauss-kb"], "target": "build" }
      ],
      // Two passes. `hook.spec.mjs` asserts a 150 ms wall-clock budget on the
      // gate's idle path, so merge-policy's fixture pass — eleven repositories,
      // each spawning the gate — runs after it rather than beside it.
      "command": "node --test \"plugins/strauss-kb-review/hooks/scripts/*.spec.mjs\" \"plugins/strauss-kb-review/skills/review-walkthrough/scripts/*.spec.mjs\" && node --test \"plugins/strauss-kb-review/skills/merge-policy/scripts/*.spec.mjs\""
    },
    "validate": {
      "command": "claude plugin validate .",
      "options": {
        "cwd": "plugins/strauss-kb-review"
      }
    }
  }
}
