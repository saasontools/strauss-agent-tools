{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*strauss[-_]kb.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/kb-reviewer-gate.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/kb-reviewer-gate.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/kb-reviewer-gate.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
