{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "cache": true
    },
    "test": {
      "cache": true,
      "dependsOn": ["build"],
      "outputs": ["{projectRoot}/coverage"]
    },
    "lint": {
      "cache": true
    },
    "validate": {
      "cache": false
    }
  },
  "release": {
    "projectsRelationship": "independent",
    "projects": ["packages/*"],
    "versionPlans": true,
    "changelog": {
      "projectChangelogs": {
        "createRelease": "github"
      },
      "workspaceChangelog": false
    }
  }
}
