{
  "name": "@saasontools/codex-claude-agent",
  "version": "0.1.2",
  "description": "Delegate arbitrary coding tasks from Codex to Claude Code through the Claude Agent SDK: worktrees, tool policy, budgets, retries, tracked background jobs, and one structured RunResult",
  "license": "MIT",
  "author": "Assaf Kamil",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "codex-claude-agent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "keywords": [
    "claude-code",
    "codex",
    "agent-sdk",
    "subagent",
    "worktree",
    "agent"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saasontools/strauss-agent-tools.git",
    "directory": "packages/codex-claude-agent"
  },
  "scripts": {
    "prepack": "tsup",
    "build": "tsup",
    "schema": "node scripts/generate-schema.mjs && prettier --write schemas/run-result.schema.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.251",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "zod": "^4.5.4"
  }
}
