{
  "name": "@saasontools/code-diff",
  "version": "0.1.0",
  "description": "Unified diffs, hunks, changed symbols and file classes from a git range, with no knowledge base behind them",
  "license": "MIT",
  "author": "Assaf Kamil",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "git",
    "diff",
    "unified-diff",
    "gitattributes",
    "code-review"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saasontools/strauss-agent-tools.git",
    "directory": "packages/code-diff"
  },
  "scripts": {
    "prepack": "tsup",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@saasontools/git-guard": "workspace:0.x"
  }
}
