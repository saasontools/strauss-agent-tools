{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.saasontools/gemini-deep-research-mcp",
  "description": "MCP server for Google Gemini Deep Research: long-running research jobs with async job handles",
  "version": "1.0.0",
  "repository": {
    "url": "https://github.com/saasontools/strauss-agent-tools",
    "source": "github",
    "subfolder": "packages/gemini-deep-research-mcp"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@saasontools/gemini-deep-research-mcp",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GEMINI_API_KEY",
          "description": "GEMINI_API_KEY used by the server",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
